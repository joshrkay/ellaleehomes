{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/process",
      "destination": "/build-your-home",
      "permanent": true
    },
    {
      "source": "/projects",
      "destination": "/previous-projects",
      "permanent": true
    },
    {
      "source": "/sell",
      "destination": "/sell-your-home",
      "permanent": true
    },
    {
      "source": "/investors",
      "destination": "/developers",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/uploads/(w|d)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
