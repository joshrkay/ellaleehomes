{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.ellaleehomes.com"
        }
      ],
      "destination": "https://ellaleehomes.com/$1",
      "permanent": true
    },
    {
      "source": "/process",
      "destination": "/build-your-home",
      "permanent": true
    },
    {
      "source": "/projects",
      "destination": "/previous-projects",
      "permanent": true
    },
    {
      "source": "/sell",
      "destination": "/sell-your-home",
      "permanent": true
    },
    {
      "source": "/investors",
      "destination": "/developers",
      "permanent": true
    },
    {
      "source": "/project",
      "has": [
        {
          "type": "query",
          "key": "slug",
          "value": "(?<slug>.+)"
        }
      ],
      "destination": "/homes/:slug",
      "permanent": true
    },
    {
      "source": "/project.html",
      "has": [
        {
          "type": "query",
          "key": "slug",
          "value": "(?<slug>.+)"
        }
      ],
      "destination": "/homes/:slug",
      "permanent": true
