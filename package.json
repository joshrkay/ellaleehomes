{
  "name": "ellaleehomes-site",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/validate-projects.mjs --summary && node scripts/check-copy.mjs && node scripts/build-html.mjs && node scripts/check-launch.mjs --summary",
    "check:copy": "node scripts/check-copy.mjs",
    "check:assets": "node scripts/check-assets.mjs",
    "check:projects": "node scripts/validate-projects.mjs",
    "launch:report": "node scripts/check-launch.mjs",
    "check:launch": "node scripts/check-launch.mjs --strict",
    "qa:chrome": "node scripts/qa-chrome.cjs",
    "watch": "node scripts/watch.mjs",
    "dev": "npm run build && concurrently -k \"npm run watch\" \"browser-sync start --server dist --files dist --no-open\"",
    "projects:csv": "node scripts/export-projects-csv.mjs",
    "projects:import": "node scripts/import-projects.mjs"
  },
  "devDependencies": {
    "browser-sync": "^3.0.3",
    "chokidar": "^4.0.3",
    "concurrently": "^9.1.0"
  }
}
